# Vouch's secrets, from the system keyring: lookups only, never a value (#31). Run `direnv allow`
# once. A key missing from the keyring is left empty, and Vouch treats empty as unset.
# Every name Vouch reads is in .env.example; vouch.settings reads them.

export OPENROUTER_API_KEY=$(secret-tool lookup service openrouter)
export CLERK_SECRET_KEY=$(secret-tool lookup service clerk-vouch-secret)
export CLERK_PUBLISHABLE_KEY=$(secret-tool lookup service clerk-vouch-publishable)
export CLERK_JWT_KEY=$(secret-tool lookup service clerk-vouch-jwt-key)
export VOUCH_DATABASE_URL=$(secret-tool lookup service cloudsql-vouch-local-url)
export LANGFUSE_PUBLIC_KEY=$(secret-tool lookup service langfuse-vouch-public)
export LANGFUSE_SECRET_KEY=$(secret-tool lookup service langfuse-vouch-secret)

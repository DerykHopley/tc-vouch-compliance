#!/usr/bin/env bash
# Pre-push: the fast lane's quickest checks (CLAUDE.md, CI). Each check runs once its tool exists;
# until M0 carries the code over, the missing ones are skipped with a note.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
refs=$(cat)  # git's ref lines, read first so no check below swallows them (#340)
if [ -f pyproject.toml ]; then
  # One check a line: under set -e a failure before the last command of an && chain doesn't
  # stop the script (#243 found `ruff check && mypy` passing a ruff failure).
  uv run ruff check
  uv run ruff format --check
  uv run mypy
else echo "pre-push: no pyproject.toml yet, ruff and mypy skipped"; fi
if [ -f frontend/package.json ] && [ ! -d frontend/node_modules ]; then
  # A fresh checkout or worktree has none: install them rather than refuse the push (M3 retro).
  echo "pre-push: frontend/node_modules is missing (a fresh checkout or worktree); running npm ci" >&2
  npm --prefix frontend ci --no-audit --no-fund --loglevel=error
fi
if [ -f frontend/package.json ]; then npm --prefix frontend run lint; else echo "pre-push: no frontend yet, lint skipped"; fi
if [ -d frontend/src ]; then
  python3 -I -B scripts/design-lint.py frontend/src
  python3 -I -B scripts/token-roles.py frontend/src
else echo "pre-push: no frontend/src yet, design-lint skipped"; fi
# No machine-local path (a home folder, Claude's /tmp scratch) in the commits being pushed (#340).
printf '%s\n' "$refs" | python3 -I -B scripts/local-paths.py --pre-push

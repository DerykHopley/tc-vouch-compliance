# Names only, never values. Secrets live in the system keyring; the committed .envrc loads them,
# e.g. export CLERK_SECRET_KEY=$(secret-tool lookup service clerk-vouch-secret).
# Don't create a .env file. Every name vouch.settings reads is here (tests/test_settings.py).
# Unset and empty mean the same. The database settings join with #33.

# Sign-in. local (the default): no sign-in, one default user, for a developer's machine only.
# With any Clerk key set it must be set too (local or clerk), or the API refuses to start (#151).
# clerk: the container's mode (Dockerfile); it refuses to start without the three Clerk keys
# and CLERK_AUTHORIZED_PARTIES.
VOUCH_AUTH_MODE=             # local | clerk
VOUCH_LOCAL_USER_NAME=       # local mode's user's name on audit entries (default: Local user)

# Clerk development instance (#28). Keyring service name on the right.
CLERK_SECRET_KEY=            # clerk-vouch-secret       (sk_...)
CLERK_PUBLISHABLE_KEY=       # clerk-vouch-publishable  (pk_...)
CLERK_JWT_KEY=               # clerk-vouch-jwt-key      (PEM public key, for networkless token checks)
# Not a secret, so not in the keyring or .envrc: the origins Vouch's pages are served from,
# comma-separated, no path. A session token from any other page (its `azp`) is refused.
# Locally, e.g. http://localhost:8000,http://localhost:5173; on Cloud Run, the service's URL.
CLERK_AUTHORIZED_PARTIES=    # (required in clerk mode)
# Not a secret: the course's Discord server (#152). Set, clerk mode lets in its members (and
# invited users and developers) and refuses everyone else; unset, Clerk's restrictions decide.
DISCORD_SERVER_ID=           # 17 to 20 digits (Discord: Developer Mode, Copy Server ID)

# The model. With the key set and ASSESS_FAKE_SCRIPT unset, the API and the CLI use OpenRouter (paid).
# ASSESS_MODEL is the API's default until a developer chooses one on the developer page.
OPENROUTER_API_KEY=          # openrouter               (sk-or-...)
ASSESS_MODEL=                # an OpenRouter model id, e.g. anthropic/claude-haiku-5.5
ASSESS_FAKE_SCRIPT=          # a scripted fake model's script (tests/scripts/*.json): no key, no cost

# Where things are. Defaults suit a checkout; the image sets VOUCH_FRONTEND.
VOUCH_FRONTEND=              # the built front end to serve (frontend/dist); unset serves the API alone
VOUCH_PROFILES_DIR=          # the compliance profiles, one folder each; unset: the repository's fixtures/
# Postgres (#33): locally through the Cloud SQL Auth Proxy; on Cloud Run, its Unix socket.
VOUCH_DATABASE_URL=

# Limits. Unset: a user's 61st request in a minute gets 429 (frontend/e2e/run.sh raises it).
VOUCH_RATE_REQUESTS=         # requests a minute, a whole number above 0
# The profile pass (#371, #432): a pass whose prompt and expected reply are estimated over this
# many tokens together is refused, and the per-control agent assesses instead. Unset: 100000.
VOUCH_PROFILE_PASS_TOKENS=   # tokens, a whole number above 0

# Tracing in Langfuse (#460): each assessment, chat turn and profile pass is one trace, its
# model calls, steps and tool calls masked by vouch.redaction. Both keys set: on; either unset:
# off, no Langfuse client made. On Cloud Run they come from Secret Manager when they exist there.
LANGFUSE_PUBLIC_KEY=         # langfuse-cloud-public-key    (pk-lf-...)
LANGFUSE_SECRET_KEY=         # langfuse-cloud-secret-key    (sk-lf-...)
# Not a secret, so not in the keyring or .envrc. Unset: Langfuse Cloud's EU region. The eval
# runner's --trace needs a local Langfuse here (http://localhost:3300), never Langfuse Cloud.
LANGFUSE_BASE_URL=           # an origin, e.g. https://us.cloud.langfuse.com

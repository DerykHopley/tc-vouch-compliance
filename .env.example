# Names only, never values. Secrets live in the system keyring; a committed .envrc
# (M3, #31) loads them, e.g. export CLERK_SECRET_KEY=$(secret-tool lookup service clerk-vouch-secret).
# Don't create a .env file. #31 adds the rest of the settings (model, database, auth mode).

# Clerk development instance (#28). Keyring service name on the right.
CLERK_SECRET_KEY=            # clerk-vouch-secret       (sk_...)
CLERK_PUBLISHABLE_KEY=       # clerk-vouch-publishable  (pk_...)
CLERK_JWT_KEY=               # clerk-vouch-jwt-key      (PEM public key, for networkless token checks)
